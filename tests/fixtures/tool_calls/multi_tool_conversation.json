[
  {
    "role": "system",
    "content": "You are a helpful assistant."
  },
  {
    "role": "user",
    "content": "Read test.py and config.yaml, then tell me what they do."
  },
  {
    "role": "assistant",
    "content": "",
    "tool_calls": [
      {
        "id": "tc_read_1",
        "name": "read_file",
        "arguments": {"path": "test.py"}
      },
      {
        "id": "tc_read_2",
        "name": "read_file",
        "arguments": {"path": "config.yaml"}
      }
    ]
  },
  {
    "role": "tool",
    "content": "def main():\n    print('hello')",
    "tool_call_id": "tc_read_1",
    "name": "read_file"
  },
  {
    "role": "tool",
    "content": "debug: true\nport: 8080",
    "tool_call_id": "tc_read_2",
    "name": "read_file"
  },
  {
    "role": "assistant",
    "content": "test.py is a simple script that prints hello. config.yaml sets debug mode on port 8080."
  },
  {
    "role": "user",
    "content": "Now run test.py"
  },
  {
    "role": "assistant",
    "content": "",
    "tool_calls": [
      {
        "id": "tc_bash_1",
        "name": "bash",
        "arguments": {"command": "python3 test.py"}
      }
    ]
  },
  {
    "role": "tool",
    "content": "hello",
    "tool_call_id": "tc_bash_1",
    "name": "bash"
  },
  {
    "role": "assistant",
    "content": "The script ran successfully and printed 'hello'."
  }
]
